# Plantilla de configuración para despliegue o automatización.
# Este sitio es estático y NO lee archivos .env en tiempo de ejecución.
# La configuración efectiva de los formularios está en js/formularios-config.js.
# No escribas contraseñas, API keys ni tokens privados en este archivo.

SITIO_BASE_URL=http://localhost:5500
PUERTO_LOCAL=5500

# Endpoints públicos de Formspree. Reemplaza REEMPLAZAR_ID_... por tus identificadores.
FORMSPREE_CONTACTO_URL=https://formspree.io/f/REEMPLAZAR_ID_CONTACTO
FORMSPREE_MATRICULA_URL=https://formspree.io/f/REEMPLAZAR_ID_MATRICULA

ENTORNO=development
